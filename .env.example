PORT=3000

# The email where voice notes will be sent
RECIPIENT_EMAIL=urazaslanparlak@gmail.com

# SMTP Sender Configuration (e.g. Gmail)
# If using Gmail, set SMTP_HOST=smtp.gmail.com and SMTP_PORT=587.
# For SMTP_PASS, you must generate a Gmail "App Password" (Uygulama Şifresi) from Google Account security settings.
# IF LEFT BLANK: The server will save all recordings to a local "recordings/" folder as a fallback!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
